BOT_TOKEN=

# Лимиты Telegram Cloud Bot API с небольшим запасом.
MAX_PHOTO_BYTES=9500000
MAX_VIDEO_BYTES=49000000
MAX_TOTAL_BYTES=100000000

# Ограничения нагрузки и времени ожидания.
DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_REQUEST_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=300
VIDEO_COMPRESSION_THRESHOLD_BYTES=8000000
VIDEO_COMPRESSION_CRF=28
VIDEO_COMPRESSION_MAX_WIDTH=1280
MAX_CONCURRENT_REQUESTS=2
MAX_PENDING_REQUESTS=8
MAX_REQUESTS_PER_USER_MINUTE=3
MAX_REQUESTS_PER_MINUTE=20

# Необязательно: отдельный каталог для временных файлов.
# TEMP_ROOT=./tmp
